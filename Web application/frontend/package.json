{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare-assets && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare-assets": "node scripts/optimize-assets.js",
    "docker:build": "docker build -f ../docker/frontend/Dockerfile -t chasecart-frontend ..",
    "docker:run": "docker run -p 3000:80 chasecart-frontend",
    "docker:deploy": "cd ../docker && docker-compose up -d",
    "docker:stop": "cd ../docker && docker-compose down",
    "start": "npm run preview",
    "vercel-build": "npm run build",
    "railway:start": "npm run preview -- --host 0.0.0.0 --port $PORT",
    "render:start": "npm run preview -- --host 0.0.0.0 --port $PORT",
    "test": "vitest",
    "test:assets": "vitest tests/assets.test.js",
    "test:docker": "vitest tests/docker.test.js",
    "test:integration": "vitest tests/integration.test.js",
    "test:optimize": "vitest tests/optimize-assets.test.js",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:all": "node tests/run-all-tests.js"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@reduxjs/toolkit": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.25.0",
    "firebase": "^12.2.1",
    "framer-motion": "^12.23.19",
    "immer": "^10.1.1",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-redux": "^9.2.0",
    "react-router": "7.5.2",
    "react-router-dom": "^7.1.3",
    "react-tsparticles": "^2.12.2",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "remixicon": "^4.6.0",
    "reselect": "^5.1.1",
    "shadcn-ui": "^0.9.5",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.0",
    "vitest": "^2.1.8"
  }
}
